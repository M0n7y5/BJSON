{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WarningSample",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Z]"
    },
    "score": {
      "type": "integer",
      "minimum": 0
    }
  }
}
